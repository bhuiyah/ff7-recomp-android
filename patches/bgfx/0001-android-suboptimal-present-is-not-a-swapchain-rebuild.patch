+				// swapchain, and could rebuild every frame without presenting any. A size
+				// change still comes as VK_ERROR_OUT_OF_DATE_KHR.
+				break;
+#endif // BX_PLATFORM_ANDROID
+
 			case VK_ERROR_OUT_OF_DATE_KHR:
+#if !BX_PLATFORM_ANDROID
