diff --git a/runtime/win32hle/guest_alloc.c b/runtime/win32hle/guest_alloc.c
new file mode 100644
index 0000000..2bd7d4c
--- /dev/null
+++ b/runtime/win32hle/guest_alloc.c
@@ -0,0 +1,199 @@
+/*
+ * guest_alloc.c - memory the guest can address, on any host. See guest_alloc.h.
+ *
+ * Under RECOMP_FLAT_MEMORY a guest address is a host address truncated to 32 bits. On a
+ * 32-bit host malloc already satisfies that. On a 64-bit host (Linux/Android arm64,
+ * x86-64) malloc returns addresses above 4 GB, so every block the guest is handed an
+ * address of -- heap blocks, the TIB, guest stacks, DIB bits -- comes from one arena
+ * reserved at a fixed low range instead.
+ *
+ * The allocator is first-fit over an address-ordered free list with neighbour
+ * coalescing. Each block carries a 16-byte header (size + magic) so free/realloc need
+ * no lookup and catch foreign pointers. One mutex; guest calls are also serialised by
+ * the machine lock, but host threads (audio, the present layer) may allocate too.
+ */
+#define _GNU_SOURCE
+#include <errno.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "guest_alloc.h"
+
+#if UINTPTR_MAX > 0xffffffffu
+#include <sys/mman.h>
+#ifndef MAP_FIXED_NOREPLACE
+#define MAP_FIXED_NOREPLACE 0x100000
+#endif
+#define GA_ARENA 1
+#endif
+
+#define GA_MAGIC  0x47414C43u   /* 'GALC' */
+#define GA_ALIGN  16u
+#define GA_HDR    16u
+
+typedef struct ga_hdr { uint32_t size; uint32_t magic; uint32_t pad[2]; } ga_hdr; /* size includes header */
+typedef struct ga_free { uint32_t addr, size; } ga_free;
+
+static pthread_mutex_t g_ga_lock = PTHREAD_MUTEX_INITIALIZER;
+static ga_free *g_free;           /* address-ordered free ranges (host memory, not guest) */
+static int      g_free_n, g_free_cap;
+static uint32_t g_arena_lo, g_arena_hi;
+static uint64_t g_live;
+
+static void ga_die(const char *what, uint32_t va) {
+    fprintf(stderr, "[guest_alloc] FATAL: %s (0x%08X)\n", what, va);
+    abort();
+}
+
+int guest_alloc_init(uint32_t lo, uint32_t hi) {
+    if (g_arena_hi) return 0;
+#ifdef GA_ARENA
+    void *p = mmap((void *)(uintptr_t)lo, (size_t)(hi - lo), PROT_READ | PROT_WRITE,
+                   MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE | MAP_FIXED_NOREPLACE, -1, 0);
+    if (p == MAP_FAILED || (uintptr_t)p != lo) {
+        fprintf(stderr, "[guest_alloc] cannot reserve [0x%08X,0x%08X): %s\n", lo, hi, strerror(errno));
+        if (p != MAP_FAILED) munmap(p, (size_t)(hi - lo));
+        return -1;
+    }
+#endif
+    g_arena_lo = lo;
+    g_arena_hi = hi;
+    g_free_cap = 256;
+    g_free = (ga_free *)malloc(sizeof *g_free * (size_t)g_free_cap);
+    g_free[0].addr = lo;
+    g_free[0].size = hi - lo;
+    g_free_n = 1;
+    return 0;
+}
+
+static void ga_insert_free(uint32_t addr, uint32_t size) {
+    int i = 0;
+    while (i < g_free_n && g_free[i].addr < addr) i++;
+    /* merge with previous / next neighbour where they touch */
+    int merged_prev = (i > 0 && g_free[i - 1].addr + g_free[i - 1].size == addr);
+    int merged_next = (i < g_free_n && addr + size == g_free[i].addr);
+    if (merged_prev && merged_next) {
+        g_free[i - 1].size += size + g_free[i].size;
+        memmove(&g_free[i], &g_free[i + 1], sizeof *g_free * (size_t)(g_free_n - i - 1));
+        g_free_n--;
+    } else if (merged_prev) {
+        g_free[i - 1].size += size;
+    } else if (merged_next) {
+        g_free[i].addr = addr;
+        g_free[i].size += size;
+    } else {
+        if (g_free_n == g_free_cap) {
+            g_free_cap *= 2;
+            g_free = (ga_free *)realloc(g_free, sizeof *g_free * (size_t)g_free_cap);
+        }
+        memmove(&g_free[i + 1], &g_free[i], sizeof *g_free * (size_t)(g_free_n - i));
+        g_free[i].addr = addr;
+        g_free[i].size = size;
+        g_free_n++;
+    }
+}
+
+static uint32_t ga_take(uint32_t need) {
+    for (int i = 0; i < g_free_n; i++) {
+        if (g_free[i].size >= need) {
+            uint32_t a = g_free[i].addr;
+            g_free[i].addr += need;
+            g_free[i].size -= need;
+            if (!g_free[i].size) {
+                memmove(&g_free[i], &g_free[i + 1], sizeof *g_free * (size_t)(g_free_n - i - 1));
+                g_free_n--;
+            }
+            return a;
+        }
+    }
+    return 0;
+}
+
+static void *ga_alloc_locked(size_t n, int zero) {
+    if (!g_arena_hi) {
+        /* 32-bit host or no arena: malloc already gives guest-addressable memory. */
+        void *p = zero ? calloc(1, n ? n : 1) : malloc(n ? n : 1);
+#if UINTPTR_MAX > 0xffffffffu
+        if (p && (uintptr_t)p > 0xffffffffu) ga_die("guest_alloc_init was not called on a 64-bit host", 0);
+#endif
+        return p;
+    }
+    if (n > 0x7fffffffu) return NULL;
+    uint32_t need = (uint32_t)((n + GA_HDR + GA_ALIGN - 1) & ~(size_t)(GA_ALIGN - 1));
+    uint32_t a = ga_take(need);
+    if (!a) return NULL;
+    ga_hdr *h = (ga_hdr *)(uintptr_t)a;
+    h->size = need;
+    h->magic = GA_MAGIC;
+    g_live += need;
+    void *p = (uint8_t *)h + GA_HDR;
+    if (zero) memset(p, 0, need - GA_HDR);
+    return p;
+}
+
+static ga_hdr *ga_header(void *p) {
+    uintptr_t a = (uintptr_t)p;
+    if (a < (uintptr_t)g_arena_lo + GA_HDR || a >= g_arena_hi) ga_die("free of a pointer outside the guest arena", (uint32_t)a);
+    ga_hdr *h = (ga_hdr *)(a - GA_HDR);
+    if (h->magic != GA_MAGIC) ga_die("free of a corrupt or foreign guest block", (uint32_t)a);
+    return h;
+}
+
+void *guest_malloc(size_t n) {
+    pthread_mutex_lock(&g_ga_lock);
+    void *p = ga_alloc_locked(n, 0);
+    pthread_mutex_unlock(&g_ga_lock);
+    return p;
+}
+
+void *guest_calloc(size_t count, size_t n) {
+    if (n && count > SIZE_MAX / n) return NULL;
+    pthread_mutex_lock(&g_ga_lock);
+    void *p = ga_alloc_locked(count * n, 1);
+    pthread_mutex_unlock(&g_ga_lock);
+    return p;
+}
+
+void guest_free(void *p) {
+    if (!p) return;
+    pthread_mutex_lock(&g_ga_lock);
+    if (!g_arena_hi) { free(p); pthread_mutex_unlock(&g_ga_lock); return; }
+    ga_hdr *h = ga_header(p);
+    uint32_t a = (uint32_t)(uintptr_t)h, size = h->size;
+    h->magic = 0;
+    g_live -= size;
+    ga_insert_free(a, size);
+    pthread_mutex_unlock(&g_ga_lock);
+}
+
+size_t guest_msize(void *p) {
+    if (!p) return 0;
+    if (!g_arena_hi) return 0;   /* unknown for libc blocks; callers only use it on arena hosts */
+    pthread_mutex_lock(&g_ga_lock);
+    size_t n = ga_header(p)->size - GA_HDR;
+    pthread_mutex_unlock(&g_ga_lock);
+    return n;
+}
+
+void *guest_realloc(void *p, size_t n) {
+    if (!p) return guest_malloc(n);
+    if (!n) { guest_free(p); return NULL; }
+    pthread_mutex_lock(&g_ga_lock);
+    if (!g_arena_hi) { void *q = realloc(p, n); pthread_mutex_unlock(&g_ga_lock); return q; }
+    size_t old = ga_header(p)->size - GA_HDR;
+    pthread_mutex_unlock(&g_ga_lock);
+    if (n <= old) return p;
+    void *q = guest_malloc(n);
+    if (!q) return NULL;
+    memcpy(q, p, old);
+    guest_free(p);
+    return q;
+}
+
+uint64_t guest_alloc_live_bytes(void) { return g_live; }
+int guest_alloc_is_guest(const void *p) {
+    uintptr_t a = (uintptr_t)p;
+    return g_arena_hi ? (a >= g_arena_lo && a < g_arena_hi) : (a <= 0xffffffffu);
+}
diff --git a/runtime/win32hle/guest_alloc.h b/runtime/win32hle/guest_alloc.h
new file mode 100644
index 0000000..7c358aa
--- /dev/null
+++ b/runtime/win32hle/guest_alloc.h
@@ -0,0 +1,30 @@
+/*
+ * guest_alloc.h - allocations the guest can hold a 32-bit address of.
+ *
+ * Every block whose address is handed to lifted code (heap blocks, TIBs, guest stacks,
+ * DIB bits, COM objects) must lie below 4 GB under RECOMP_FLAT_MEMORY. On a 32-bit host
+ * these fall through to libc. On a 64-bit host the host first reserves a low arena with
+ * guest_alloc_init(lo, hi) -- e.g. [0x10000000, 0x70000000) -- and they are served from it.
+ */
+#ifndef GUEST_ALLOC_H
+#define GUEST_ALLOC_H
+#include <stddef.h>
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Reserve [lo, hi) for guest allocations (64-bit hosts). 0 on success. Idempotent. */
+int    guest_alloc_init(uint32_t lo, uint32_t hi);
+void  *guest_malloc(size_t n);
+void  *guest_calloc(size_t count, size_t n);
+void  *guest_realloc(void *p, size_t n);
+void   guest_free(void *p);
+size_t guest_msize(void *p);                 /* usable size of a block; 0 on 32-bit hosts */
+uint64_t guest_alloc_live_bytes(void);
+int    guest_alloc_is_guest(const void *p);  /* 1 if p is guest-addressable */
+
+#ifdef __cplusplus
+}
+#endif
+#endif
