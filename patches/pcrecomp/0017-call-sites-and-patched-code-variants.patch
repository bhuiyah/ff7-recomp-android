--- a/runtime/recomp32/recomp_types.h
+++ b/runtime/recomp32/recomp_types.h
@@ -1184,6 +1184,25 @@
 void recomp_hook(uint32_t va);
 #define RECOMP_HOOK(va) do { RECOMP_REGS_OUT(); recomp_hook(va); RECOMP_REGS_IN(); } while (0)
 
+/* A direct call with its site VA (the call instruction), so a port can redirect calls
+ * site by site at run time (call-site hooks, as a binary patcher would). By default the
+ * site is unused. */
+#ifndef RECOMP_CALL_AT
+#define RECOMP_CALL_AT(site, func) RECOMP_CALL(func)
+#endif
+#ifndef RECOMP_ICALL_AT
+#define RECOMP_ICALL_AT(site, target_va) RECOMP_ICALL(target_va)
+#endif
+/* Patched-code variants (Lifter code_variants): true when the n bytes at va equal `bytes`
+ * wherever `mask` is non-zero, i.e. the run-time image carries that patch. */
+#ifndef RECOMP_CODE_MATCH
+static inline int recomp_code_match(uint32_t va, const char *bytes, const char *mask, uint32_t n) {
+    for (uint32_t i = 0; i < n; i++) if ((uint8_t)mask[i] && MEM8(va + i) != (uint8_t)bytes[i]) return 0;
+    return 1;
+}
+#define RECOMP_CODE_MATCH(va, bytes, mask, n) recomp_code_match((va), (bytes), (mask), (n))
+#endif
+
 /* Always-callable trace dump (no-op unless RECOMP_TRACE). */
 void recomp_dump_trace(const char* why);
 
