<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x401000" android:required="true" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <!-- The launcher's mod catalogs: catalog lists, previews and mod downloads. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Building the game on the device (BuildService.java): minutes of work in the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- the game back in front on the top screen after Pixel Guide opens on the bottom one -->
    <uses-permission android:name="android.permission.REORDER_TASKS" />
    <!-- Updates from the GitHub releases, installed in the app (Updater.java). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Rumble (Settings > Controller): the device's motor, or a controller's. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Pixel Guide: the bottom screen's book opens it when it is installed (CompanionView) -->
    <queries>
        <package android:name="app.nanostack.pixelguide" />
    </queries>

    <application
        android:label="FF7Recomp"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:hasCode="true"
        android:extractNativeLibs="true"
        android:isGame="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
        <!-- The entry point: game files, mods, settings, Play (LauncherActivity.java). -->
        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- The game, in its own process: the lifted exe boots once per process (fixed guest
             memory), so each Play starts a fresh process and quitting returns to the launcher. -->
        <!-- exported: the dev scripts (tools/run_app.sh) start it directly with adb. -->
        <activity
            android:name=".GameActivity"
            android:exported="true"
            android:process=":game"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|density|smallestScreenSize|fontScale|locale|layoutDirection"
            android:launchMode="singleTask" />
        <!-- Swap screens (GitHub #41): the second-screen panels on the main display, the game on
             the other one. In the game's process; its own task, so it stays on the main display. -->
        <activity
            android:name=".CompanionHostActivity"
            android:exported="false"
            android:process=":game"
            android:taskAffinity=".companion"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|density|smallestScreenSize" />
        <!-- Settings > On-screen controls > Size and layout (TouchLayoutActivity, GitHub #28) -->
        <activity
            android:name=".TouchLayoutActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode" />
        <!-- Test API over adb (TestControl): settings and Stop (Play: LauncherActivity test_play). DUMP: only the shell may call it -->
        <receiver
            android:name=".TestControl"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.ff7recomp.test.GET" />
                <action android:name="com.ff7recomp.test.SET" />
                <action android:name="com.ff7recomp.test.STOP" />
            </intent-filter>
        </receiver>
        <!-- Pixel Guide's installer answer (GuideInstaller), in the game's process -->
        <receiver
            android:name=".GuideInstaller$Result"
            android:exported="false"
            android:process=":game" />
        <!-- Pixel Guide's install confirmation on the bottom screen (GuideInstaller): in a process
             of its own, telling the game's process through Events -->
        <receiver
            android:name=".GuideHostActivity$Events"
            android:exported="false"
            android:process=":game" />
        <activity
            android:name=".GuideHostActivity"
            android:exported="false"
            android:process=":guide"
            android:taskAffinity=".guide"
            android:excludeFromRecents="true"
            android:noHistory="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar.Fullscreen"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode" />
        <receiver
            android:name=".Updater$InstallResult"
            android:exported="false" />
        <service
            android:name=".BuildService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
